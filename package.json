{
  "name": "proofread-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "A Windows desktop tool for reviewing visual novel translations",
  "license": "GPL-3.0-or-later",
  "author": "LightYuki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LightYuki/Proofreader.git"
  },
  "homepage": "https://github.com/LightYuki/Proofreader#readme",
  "bugs": "https://github.com/LightYuki/Proofreader/issues",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check:project": "node scripts/check-project.mjs",
    "licenses": "node scripts/prepare-licenses.mjs",
    "licenses:check": "node scripts/prepare-licenses.mjs --check",
    "check": "npm run check:project && npm test && npm run build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "diff": "^9.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
